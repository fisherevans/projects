---
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';
import { projectHref, statusLabel } from '../lib/projects';

interface Props {
    project: Project;
}

const { project } = Astro.props;
const { data } = project;
const href = projectHref(project);
const initial = data.name.trim().charAt(0).toUpperCase();
const accent = data.accent;
---

<a class="card project-card" href={href} aria-label={data.name}>
    <div class="thumb" style={accent ? `--tile-accent: ${accent}` : undefined}>
        {
            data.thumbnail ? (
                <Image src={data.thumbnail} alt={`${data.name} preview`} width={640} height={400} />
            ) : (
                <span class="tile-glyph" aria-hidden="true">
                    {initial}
                </span>
            )
        }
        {data.status !== 'active' && <span class="status-badge">{statusLabel(data.status)}</span>}
    </div>
    <div class="body">
        <h2 class="name">{data.name}</h2>
        <p class="tagline">{data.tagline}</p>
        {
            data.tech.length > 0 && (
                <ul class="tech" role="list">
                    {data.tech.slice(0, 4).map((t) => (
                        <li class="chip">{t}</li>
                    ))}
                </ul>
            )
        }
    </div>
</a>

<style>
    .project-card,
    .project-card:visited {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        color: var(--fg);
        border-bottom: none;
        padding-bottom: 0;
        background: var(--code-bg);
        box-shadow: none;
        transition:
            border-color 200ms ease-out,
            transform 200ms ease-out;
    }
    .project-card:hover,
    .project-card:focus-visible {
        border-color: var(--accent);
        background: var(--code-bg);
        box-shadow: none;
        transform: translateY(-2px);
        outline: none;
    }
    .thumb {
        --tile-accent: var(--accent);
        position: relative;
        aspect-ratio: 16 / 10;
        display: flex;
        align-items: center;
        justify-content: center;
        background:
            radial-gradient(
                120% 120% at 30% 20%,
                color-mix(in srgb, var(--tile-accent) 22%, var(--bg)) 0%,
                var(--bg) 70%
            );
        border-bottom: 1px solid var(--rule);
        overflow: hidden;
    }
    .thumb :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0;
    }
    .tile-glyph {
        font-family: 'Marauder', serif;
        font-weight: 800;
        font-variation-settings: 'opsz' 72;
        font-size: 3.5rem;
        color: color-mix(in srgb, var(--tile-accent) 70%, var(--fg));
        opacity: 0.85;
        line-height: 1;
    }
    .status-badge {
        position: absolute;
        top: 0.6rem;
        right: 0.6rem;
        font-family: var(--sans);
        font-size: 0.62rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.2em 0.6em;
        border-radius: 999px;
        background: var(--bg);
        border: 1px solid var(--rule);
        color: var(--muted);
    }
    .body {
        padding: 1rem 1.1rem 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }
    .name {
        font-size: 1.35rem;
        font-variation-settings: 'opsz' 24;
        margin: 0;
        color: var(--fg);
    }
    .project-card:hover .name,
    .project-card:focus-visible .name {
        color: var(--accent);
    }
    .tagline {
        margin: 0;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.45;
    }
    .tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin: 0.5rem 0 0;
        padding: 0;
    }
    .tech .chip {
        padding: 0.12em 0.55em;
    }
    .tech .chip::before {
        content: none;
    }
</style>
